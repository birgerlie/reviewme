# Environment Configuration Example
# Copy this to .env and update with your values

# Environment
ENVIRONMENT=development
DEBUG=true

# API
API_TITLE=Review Platform API
API_VERSION=1.0.0

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reviews
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production-very-secret-key-12345
JWT_ALGORITHM=HS256

# Anthropic AI
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Email Service (Phase 4)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=noreply@reviewplatform.com
SMTP_FROM_NAME=Review Platform

# Media Service (Phase 5)
# S3 Configuration
S3_BUCKET=reviewplatform-media
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# CDN Configuration
CDN_URL=https://cdn.reviewplatform.com

# Media Upload Limits
MAX_IMAGE_SIZE=10485760  # 10MB in bytes
MAX_VIDEO_SIZE=52428800  # 50MB in bytes

# Service URLs (for inter-service communication)
REVIEW_SERVICE_URL=http://review-service:8000
AI_SERVICE_URL=http://ai-service:8001
WIDGET_SERVICE_URL=http://widget-service:8002
EMAIL_SERVICE_URL=http://email-service:8003
MEDIA_SERVICE_URL=http://media-service:8004
