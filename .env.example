# Environment Configuration Example
# Copy this to .env and update with your values

# Environment
ENVIRONMENT=development
DEBUG=true

# API
API_TITLE=Review Platform API
API_VERSION=1.0.0

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reviews
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production-very-secret-key-12345
JWT_ALGORITHM=HS256

# Anthropic AI
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Email Service (Phase 4)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=noreply@reviewplatform.com
SMTP_FROM_NAME=Review Platform

# Media Service (Phase 5)
# S3 Configuration
S3_BUCKET=reviewplatform-media
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# CDN Configuration
CDN_URL=https://cdn.reviewplatform.com

# Media Upload Limits
MAX_IMAGE_SIZE=10485760  # 10MB in bytes
MAX_VIDEO_SIZE=52428800  # 50MB in bytes

# Service URLs (for inter-service communication)
REVIEW_SERVICE_URL=http://review-service:8000
AI_SERVICE_URL=http://ai-service:8001
WIDGET_SERVICE_URL=http://widget-service:8002
EMAIL_SERVICE_URL=http://email-service:8003
MEDIA_SERVICE_URL=http://media-service:8004
PLATFORM_SERVICE_URL=http://platform-service:8005

# ==============================================
# Platform Integration Settings (Shopify, WooCommerce, etc.)
# ==============================================

# Shopify OAuth Configuration
SHOPIFY_API_KEY=your-shopify-api-key-here
SHOPIFY_API_SECRET=your-shopify-api-secret-here
SHOPIFY_API_VERSION=2024-01
SHOPIFY_SCOPES=read_products,read_orders,write_products,read_customers

# Shopify OAuth Redirect URLs
# Must match the redirect URL registered in your Shopify App settings
SHOPIFY_OAUTH_REDIRECT_URL=https://api.yourdomain.com/auth/shopify/callback

# WooCommerce OAuth Configuration (Future Implementation)
WOOCOMMERCE_CONSUMER_KEY=your-woocommerce-consumer-key
WOOCOMMERCE_CONSUMER_SECRET=your-woocommerce-consumer-secret

# BigCommerce OAuth Configuration (Future Implementation)
BIGCOMMERCE_CLIENT_ID=your-bigcommerce-client-id
BIGCOMMERCE_CLIENT_SECRET=your-bigcommerce-client-secret

# Review Token Settings
REVIEW_TOKEN_EXPIRY_DAYS=30
REVIEW_REQUEST_DELAY_DAYS=7

# Review Link Base URL (where customers submit reviews)
REVIEW_BASE_URL=https://reviews.yourdomain.com

# Platform Webhook Settings
WEBHOOK_RETRY_MAX_ATTEMPTS=3
WEBHOOK_RETRY_DELAY_SECONDS=300

# Email Campaign Settings
ENABLE_REVIEW_REQUESTS=true
ENABLE_REVIEW_CONFIRMATIONS=true
ENABLE_REVIEW_REMINDERS=false

# Email Template Settings
EMAIL_TEMPLATE_DIR=services/email_service/templates
DEFAULT_STORE_NAME=Your Store
DEFAULT_SUPPORT_EMAIL=support@yourdomain.com

# Rate Limiting (for platform API calls)
SHOPIFY_API_RATE_LIMIT=40
SHOPIFY_API_RATE_WINDOW=1

# Session/Cache Settings for OAuth State
OAUTH_STATE_TTL_SECONDS=600

# Feature Flags
ENABLE_PLATFORM_SHOPIFY=true
ENABLE_PLATFORM_WOOCOMMERCE=false
ENABLE_PLATFORM_BIGCOMMERCE=false
ENABLE_AI_MODERATION=true
ENABLE_WIDGET_CUSTOMIZATION=true

# Celery Configuration (for async tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=600

# Merchant Settings
MERCHANT_FREE_PLAN_REVIEW_LIMIT=100
MERCHANT_PRO_PLAN_REVIEW_LIMIT=10000
MERCHANT_ENTERPRISE_PLAN_REVIEW_LIMIT=100000
